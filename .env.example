# Optional bootstrap only.
# Prefer configuring Provider / Intent in the UI — keys are saved to local
# user_settings.json (gitignored), not written back into this file.
#
# Copy if you want headless/CI defaults:
#   copy .env.example .env

# --- Primary LLM (OpenAI-compatible) ---
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# MODEL_NAME=

# --- Wake / voice (non-secret) ---
WAKE_WORD=hey zara
USE_STREAMING_WAKE=false

# --- Intent (optional bootstrap) ---
# INTENT_ENABLED=true
# INTENT_BACKEND=openai
# INTENT_PROVIDER=openrouter
# INTENT_BASE_URL=
# INTENT_API_KEY=
# INTENT_MODEL=
# INTENT_CONFIDENCE_THRESHOLD=0.7

# --- Voice / VAD tweaks ---
# VOICE_SILENCE_TIMEOUT=2.0
# WAKE_TIMEOUT=25
# MINIMUM_SPEECH_DURATION=0.5
# CONTINUOUS_CONVERSATION=true
# USE_BARGE_IN=false
