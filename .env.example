# Copy this file to .env and fill in your values:
#   copy .env.example .env

# --- Primary LLM (OpenAI-compatible) ---
# Provider id: openrouter | openai | groq | deepseek | together | ollama | lmstudio | custom
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key_here
MODEL_NAME=openrouter/free

# Legacy alias still supported (used when LLM_API_KEY is empty and provider is OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Wake word — Zara only (say "Hey Zara"). Streaming Alexa/Jarvis models stay off.
WAKE_WORD=hey zara
USE_STREAMING_WAKE=false

# Intent classification (optional)
INTENT_ENABLED=true
# gemini = Google AI SDK · openai = any OpenAI-compatible endpoint
INTENT_BACKEND=gemini
INTENT_PROVIDER=openrouter
INTENT_BASE_URL=
INTENT_API_KEY=
INTENT_MODEL=gemini-2.0-flash
INTENT_CONFIDENCE_THRESHOLD=0.7
# Legacy Gemini key (still used when INTENT_BACKEND=gemini and INTENT_API_KEY is empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Voice / VAD (no fixed recording timer):
# VOICE_SILENCE_TIMEOUT=2.0
# WAKE_TIMEOUT=25
# MINIMUM_SPEECH_DURATION=0.3
# CONTINUOUS_CONVERSATION=true
# USE_BARGE_IN=false
