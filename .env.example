# Copy to .env and fill in values:
#   copy .env.example .env

# --- Primary LLM (OpenAI-compatible) ---
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
MODEL_NAME=

# --- Wake / voice (currently unused — app.py is text/terminal mode) ---
WAKE_WORD=hey zara
USE_STREAMING_WAKE=false

# --- Intent classification (optional) ---
# INTENT_ENABLED=true
# INTENT_BACKEND=openai
# INTENT_PROVIDER=openrouter
# INTENT_BASE_URL=
# INTENT_API_KEY=
# INTENT_MODEL=
# INTENT_CONFIDENCE_THRESHOLD=0.7

# --- Voice / VAD tweaks ---
# VOICE_SILENCE_TIMEOUT=2.0
# WAKE_TIMEOUT=25
# MINIMUM_SPEECH_DURATION=0.5
# CONTINUOUS_CONVERSATION=true
# USE_BARGE_IN=false
