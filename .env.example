# Copy to .env and fill in values:
#   copy .env.example .env

# --- Primary LLM (OpenAI-compatible) ---
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
MODEL_NAME=

